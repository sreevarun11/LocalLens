# LocalLens v4 — Environment Configuration Template

# Frontend (VITE_ = exposed to browser)
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=
VITE_FEATURE_3D=false

# Database & Persistence (Backend only)
# If DATABASE_URL is not set, LocalLens runs locally on SQLite at backend/data/locallens_dev.db
DATABASE_URL=

# Supabase Integration (Backend only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# Administration & Role Authorization
ADMIN_USERNAME=sreevarun
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# Payments (Razorpay - External KYC under review)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Spatial & Environmental APIs
GOOGLE_MAPS_SERVER_KEY=
OPENAQ_API_KEY=
OVERPASS_URL=https://z.overpass-api.de/api/interpreter
TELANGANA_PLACES_DB_PATH=backend/data/telangana_places.db
OSRM_BASE_URL=http://router.project-osrm.org
ROUTING_PROVIDER=osrm

# LLM Synthesis
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT_PER_USER=10

# Runtime Feature Flags & Environment
ENVIRONMENT=development
FEATURE_PAYMENTS=true
FEATURE_AI=true
DEMO_SNAPSHOT_MODE=false
FEATURE_COMPARE_LOAD_ALL=false

# URLs, CORS & Contact Constants
REPORT_PRICE_PAISE=2900
APP_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=
CORS_ORIGINS=
CONTACT_EMAIL=support@locallens.app
